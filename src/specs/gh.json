      { "nombre": "list", "descripcion": "Lista pull requests" },
      { "nombre": "merge", "descripcion": "Une un pull request" },
      { "nombre": "view", "descripcion": "Muestra un pull request" }
    ] },
    { "nombre": "release", "descripcion": "Versiones publicadas", "subcomandos": [
