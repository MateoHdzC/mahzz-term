      { "nombre": "list", "descripcion": "Lista versiones" }
    ] },
    { "nombre": "repo", "descripcion": "Repositorios", "subcomandos": [
      { "nombre": "clone", "descripcion": "Clona un repositorio" },
      { "nombre": "create", "descripcion": "Crea un repositorio" },
      { "nombre": "view", "descripcion": "Muestra un repositorio" }
    ] },
    { "nombre": "run", "descripcion": "GitHub Actions", "subcomandos": [
      { "nombre": "list", "descripcion": "Lista ejecuciones" },
      { "nombre": "view", "descripcion": "Muestra una ejecución" },
      { "nombre": "watch", "descripcion": "Sigue una ejecución" }
    ] }
