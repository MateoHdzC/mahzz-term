{
  "nombre": "gh",
  "descripcion": "GitHub desde la terminal",
  "opciones": [{ "nombre": "--version", "descripcion": "Muestra la versión" }],
  "subcomandos": [
    { "nombre": "auth", "descripcion": "Administra la sesión", "subcomandos": [
      { "nombre": "login", "descripcion": "Inicia sesión" },
      { "nombre": "status", "descripcion": "Muestra la sesión actual" }
    ] },
    { "nombre": "issue", "descripcion": "Issues", "subcomandos": [
      { "nombre": "create", "descripcion": "Crea un issue" },
      { "nombre": "list", "descripcion": "Lista issues" },
      { "nombre": "view", "descripcion": "Muestra un issue" }
    ] },
    { "nombre": "pr", "descripcion": "Pull requests", "subcomandos": [
      { "nombre": "checkout", "descripcion": "Baja un pull request" },
      { "nombre": "create", "descripcion": "Crea un pull request", "opciones": [
        { "nombre": "--fill", "descripcion": "Usa los datos de los commits" },
        { "nombre": "--draft", "descripcion": "Lo marca como borrador" }
