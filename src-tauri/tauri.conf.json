{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MahzzTerm",
  "mainBinaryName": "MahzzTerm",
  "version": "0.5.0",
  "identifier": "com.mahzz.mahzzterm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MahzzTerm",
        "width": 1100,
        "height": 700,
        "minWidth": 520,
        "minHeight": 320,
        "center": true,
        "decorations": false,
        "visible": false,
        "transparent": true,
        "shadow": false,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection --enable-features=NetworkServiceInProcess2 --in-process-gpu --js-flags=--max-semi-space-size=1"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data: blob:; media-src blob:; frame-src blob: http://127.0.0.1:*; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0NjUyRjM1RTNEOEU3RkUKUldUKzU5ampOUzlsWkR3TWwzM3pHcXdmRDZyeEZ0SGNTZE90d3dKQm1yc29QUmNRWVVYSGVBWVkK",
      "endpoints": [
        "https://github.com/MateoHdzC/mahzz-term/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
